# ---------------------------------------------------------------------------
# Database  (required)
# ---------------------------------------------------------------------------
# Render Postgres. Use the INTERNAL connection string on the deployed service
# and the EXTERNAL one when running locally.
DATABASE_URL="postgresql://user:password@host:5432/roster?schema=public"


# ---------------------------------------------------------------------------
# AI providers  (both optional)
# ---------------------------------------------------------------------------
# Two features use a language model: reading a coverage rule written in plain
# English, and summarising a month's problems. Neither is load-bearing.
#
# With NO keys at all the app still works completely: the rule parser falls
# back to its deterministic path (15/20 on the eval, and critically 0 wrong
# answers) and the written summary hides itself. The scheduler never touches
# a model.
#
# Requests try each configured provider in order and stop at the first
# success, so one being down or slow does not take the feature with it.

# Gemini — stronger, but slow. Measured ~11s for a one-word reply because it
# reasons before writing. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# Groq — runs Llama models on their own hardware, typically an order of
# magnitude faster. Get a key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Which order to try them in. Default is "gemini,groq".
# Set "groq,gemini" to put the faster one first.
AI_PROVIDER_ORDER="gemini,groq"

# Model names get retired without much warning, and provider error messages
# sometimes name replacements that do not exist. Run `npm run ai:models` to
# ask each provider what it will actually serve.


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV="development"
